# Copy this file to config/skillforge.env and adjust only the values you need.
# This file contains no credentials.

PYTHON_BIN=python3
VENV_DIR=.venv

# Install the VERL/Ray training stack. Set to 0 for the small CPU-only core.
INSTALL_TRAINING=1

# Teacher-guided mutation uses an API key supplied separately at runtime.
INSTALL_LLM=0

# Keep 0 on machines without a CUDA-capable GPU.
INSTALL_GPU=0

# Optional runtime defaults used by scripts/train_skillforge.sh.
ENV_NAME=alfworld/AlfredTWEnv
OUTPUT_DIR=outputs/skillforge
N_GPUS_PER_NODE=0
NNODES=1
TOTAL_EPOCHS=1
